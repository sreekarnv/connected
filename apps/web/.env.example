NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000/graphql
ENVIRONMENT=development

# Set at build time; use an HTTPS address reachable from both browsers and the
# web server. Keep web and gateway on one origin or same-site custom subdomains
# so Strict refresh cookies work. Changing this value requires a new build.
# ENVIRONMENT=production enables production build URL validation.
# Optional local GraphQL schema for offline code generation:
# GRAPHQL_SCHEMA=../gateway/schema.graphql
