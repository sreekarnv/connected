IDENTITY_URL=http://localhost:4001
SOCIAL_URL=http://localhost:4003
CONTENT_URL=http://localhost:4004
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:4000","http://127.0.0.1:4000"]'
ENVIRONMENT=development

# Build only: set to exported contracts to compose without running the services.
# OPENAPI_DIR=./openapi
# Production requires ENVIRONMENT=production, explicit non-loopback service URLs,
# OPENAPI_DIR during composition, and explicit HTTPS CORS_ORIGINS at runtime.
# Runtime HOST and PORT are supported by Hive Gateway (default port 4000).
