DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity
# Set the full unencrypted RSA private key PEM, at least 2048 bits.
# Quoted multiline values are supported. See README.md for local key setup.
JWT_PRIVATE_KEY=
JWT_KEY_ID=identity-key-1
JWT_ISSUER=connected-identity
JWT_AUDIENCE=connected-api
