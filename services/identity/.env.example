DATABASE_URL=postgresql+asyncpg://identity:identity@localhost:5432/identity
RABBITMQ_URL=amqp://connected:connected@127.0.0.1:5672/
PUBLIC_URL=http://localhost:4001
WEB_URL=http://localhost:3000
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:4000","http://127.0.0.1:4000"]'
# Local HTTP only. Keep Secure cookies enabled for HTTPS deployments.
REFRESH_COOKIE_SECURE=false
# Set the full unencrypted RSA private key PEM, at least 2048 bits.
# Quoted multiline values are supported. See README.md for local key setup.
JWT_PRIVATE_KEY=
JWT_KEY_ID=identity-key-1
JWT_ISSUER=connected-identity
JWT_AUDIENCE=connected-api
