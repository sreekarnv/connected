{
  "name": "@connected/gateway",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "compose": "mesh-compose -o supergraph.graphql",
    "dev": "NODE_ENV=development hive-gateway --config-path gateway.ts supergraph supergraph.graphql",
    "start": "NODE_ENV=production hive-gateway --config-path gateway.ts supergraph supergraph.graphql",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@12.18.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@graphql-hive/gateway": "^2.15.6",
    "@graphql-mesh/compose-cli": "^1.8.4",
    "@omnigraph/openapi": "^0.112.7",
    "graphql": "^16.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
