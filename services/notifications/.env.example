ENVIRONMENT=development
PORT=4002
RABBITMQ_URL=amqp://connected:connected@127.0.0.1:5672
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Connected <notifications@connected.test>"

# Production requires ENVIRONMENT=production and explicit authenticated RabbitMQ
# and SMTP URLs plus a real MAIL_FROM address. Keep credentials in platform secrets.
# URL-encode usernames/passwords containing reserved URL characters.
