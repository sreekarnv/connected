{
  "name": "@connected/notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import=tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import=tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "amqplib": "^2.3.1",
    "hono": "^4.13.17",
    "nodemailer": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.8",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
